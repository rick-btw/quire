{
  "name": "quire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quire: a personal Obsidian-style notes site built with Astro and published on GitHub Pages",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "astro": "7.3.2",
    "d3-force": "3.0.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "katex": "0.16.47",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/d3-force": "3.0.10",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
