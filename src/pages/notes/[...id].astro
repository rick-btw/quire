---
import { getCollection } from 'astro:content';
import NotePage from '../../components/NotePage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('notes', (entry) => entry.data.draft !== true && entry.id !== 'index');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---
<NotePage entry={entry} />
