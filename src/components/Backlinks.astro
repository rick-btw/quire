---
import { noteHref } from '../lib/url';
import type { Link, VaultIndex } from '../lib/vault/types';

interface Props {
  links: Link[];
  index: VaultIndex;
}

const { links, index } = Astro.props;
const sources = links
  .map((link) => ({ link, note: index.byId.get(link.source) }))
  .filter((item): item is { link: Link; note: NonNullable<typeof item.note> } => item.note !== undefined);
---
<section class="panel-section">
  <h2 class="panel-heading">Linked from</h2>
  {
    sources.length > 0 ? (
      <ul class="backlinks">
        {sources.map(({ link, note }) => (
          <li>
            <a href={noteHref(note.id)} dir="auto">
              {note.title}
            </a>
            <p class="context" dir="auto">
              {link.context}
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="panel-empty">No other note links here yet.</p>
    )
  }
</section>
